{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "after 10pm on saturday",
    "before 6am on sunday"
  ],
  "automergeSchedule": [
    "after 10pm on saturday",
    "before 6am on sunday"
  ],
  "updateNotScheduled": false,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Auto-merge patch + minor updates after CI passes",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "groupName": "minor and patch updates",
      "groupSlug": "minor-and-patch"
    },
    {
      "description": "Major updates wait for approval on the Dependency Dashboard, then open a PR that needs manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group and auto-merge non-major GitHub Actions updates (majors fall through to the major rule above)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pinDigest"
      ],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Isolate next-auth beta — requires manual review",
      "matchPackageNames": [
        "next-auth",
        "@auth/core"
      ],
      "groupName": "next-auth",
      "automerge": false
    },
    {
      "description": "Isolate toolchain deps (linter/formatter/test runner) for human review. playwright, playwright-core and @playwright/test move together so the CLI-installed browsers always match the runtime package (viberr nightly broke on a 1.61/1.63 split).",
      "matchPackageNames": [
        "@biomejs/biome",
        "typescript",
        "playwright",
        "playwright-core",
        "@playwright/test",
        "lefthook"
      ],
      "groupName": "toolchain",
      "automerge": false
    },
    {
      "description": "Postgres majors are data migrations (pg_upgrade + verified backups), not dependency bumps — RED tier, manual runbook only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "library/postgres"
      ],
      "allowedVersions": "<18"
    },
    {
      "description": "GREEN-tier: auto-merge @types/* major bumps — type definitions only, build-time, zero runtime risk (CI gates)",
      "matchPackageNames": [
        "@types/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "GREEN-tier: auto-merge GitHub Actions major bumps from GitHub's own publishers (actions/*, github/*) only — CI-only change, no app runtime impact (CI gates). Third-party action majors need a human merge",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/**",
        "github/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "HOLD TypeScript 7 in repos linting with typescript-eslint / eslint-config-next: typescript-eslint (8.70.1) peers typescript <6.1.0 and cannot load TS7 (no JS API). Biome repos are unaffected. Lift once typescript-eslint supports TypeScript 7.",
      "matchRepositories": [
        "a14a-org/aircoland-chat",
        "a14a-org/chili-chat",
        "a14a-org/chilitrack",
        "a14a-org/chipts",
        "a14a-org/cjp-app-demo",
        "a14a-org/cjp-deck",
        "a14a-org/cjp-quiz-deck",
        "a14a-org/cjpnl-v2",
        "a14a-org/claudebox",
        "a14a-org/coinmerce-all-hands-presentation",
        "a14a-org/datagigant-suite",
        "a14a-org/design-tool-app",
        "a14a-org/domeinenlijst-suite",
        "a14a-org/forager-app",
        "a14a-org/grs-chat",
        "a14a-org/n8n-nodes-twinfield",
        "a14a-org/omnidoku",
        "a14a-org/omnirun"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "HOLD ESLint 10: eslint-plugin-react 7.37.x (also pulled in by eslint-config-next) peers eslint <=9.7 and crashes on 10 (getFilename removed). Lift once it supports ESLint 10.",
      "matchPackageNames": [
        "eslint"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "Vite and @vitejs/plugin-react majors must move together (plugin peers the matching Vite major); one PR instead of two that each fail alone.",
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "vite"
    },
    {
      "description": "Repos whose branch protection requires an up-to-date branch: auto-merge stalls unless Renovate rebases branches that fall behind, so these keep behind-base-branch. Everywhere else rebaseWhen=conflicted avoids re-running CI on every open Renovate branch after each merge.",
      "matchRepositories": [
        "a14a-org/chilitrack",
        "a14a-org/cjp-deck",
        "a14a-org/mlxstudio",
        "a14a-org/omnirun-sdk-python",
        "a14a-org/mkb-ai-suite",
        "a14a-org/lora-tune-mlx",
        "a14a-org/learning-platform",
        "a14a-org/langchain-omnirun",
        "a14a-org/llama-index-tools-omnirun",
        "a14a-org/chilidesk",
        "a14a-org/omnirun-claude-managed-agents-worker",
        "a14a-org/chilicms",
        "a14a-org/datagigant-suite",
        "a14a-org/chili-contracts"
      ],
      "rebaseWhen": "behind-base-branch"
    },
    {
      "description": "Updates without a release timestamp (lock file maintenance, Docker digests, replacements) can never satisfy minimumReleaseAge; without this the renovate/stability-days status stays pending forever",
      "matchUpdateTypes": [
        "lockFileMaintenance",
        "digest",
        "pinDigest",
        "replacement"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "Never cross a major on override/resolution selectors: they are security pins that apply to every transitive consumer",
      "matchDepTypes": [
        "overrides",
        "pnpm.overrides",
        "resolutions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Capacitor majors must move together (peer ranges); one PR instead of several that each fail alone",
      "matchPackageNames": [
        "@capacitor/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "capacitor"
    },
    {
      "description": "Runtime versions (Node, Bun) move together and by hand: CI, Dockerfile and nixpacks pins must stay aligned with what production runs",
      "matchDepNames": [
        "node",
        "bun",
        "oven/bun",
        "library/node"
      ],
      "groupName": "runtime",
      "automerge": false
    },
    {
      "description": "CI node/bun pins in these repos match the pinned nixpkgs snapshot their Nixpacks production build uses (7a0f122f: node 24.20.0, bun 1.4.2). Renovate must not move them alone; bump them together with nixpkgsArchive by hand. The other repos moved to Railpack on 2026-10-24 (railpack.json + .nvmrc pin the production runtime), so their CI pins are free to move again.",
      "matchRepositories": [
        "a14a-org/nepaligo"
      ],
      "matchManagers": [
        "github-actions"
      ],
      "matchDepNames": [
        "node",
        "bun"
      ],
      "enabled": false
    },
    {
      "description": "Own production apps without a Coolify health check: a merge that builds but crashes at runtime becomes an outage, so no unattended merges until health checks are enabled",
      "matchRepositories": [
        "a14a-org/albion-market-tool",
        "a14a-org/chipts",
        "a14a-org/claudebox",
        "a14a-org/claudeskill-manager",
        "a14a-org/commandr",
        "a14a-org/creds-oracle",
        "a14a-org/dnb-suite",
        "a14a-org/domain-oracle",
        "a14a-org/fleet-oracle",
        "a14a-org/github-runner-image",
        "a14a-org/lemon-chat",
        "a14a-org/nepaligo",
        "a14a-org/next-lm-chat",
        "a14a-org/omnidoku",
        "a14a-org/portfolio-landings",
        "a14a-org/unicornstudio"
      ],
      "automerge": false,
      "addLabels": [
        "no-healthcheck"
      ]
    },
    {
      "description": "Default off: automerge only in the a14a-owned repos named here (own production apps and internal tools). Every other repo, including any repo added later, needs a human merge. Keep this rule LAST: it only ever sets automerge false, so the major, next-auth, toolchain, runtime and no-healthcheck rules above still hold",
      "matchRepositories": [
        "!/^a14a-org\\/(102projects|a14a-landing|a14a-os|a14a-platform-poc|albion-market-tool|axinite|betaaldbereik|bun-api-template|cantrip|ccj-web|chili-app|chili-chat|chili-contracts|chili-design-system|chilicms|chilicomply|chilicrm|chilidesk|chilitrack|chipts|claude-temper|claudebox|claudecode-skill-manager-site|claudeskill-manager|client-brandkits|combin3-app|commandr|create-chili-app|creds-oracle|design-tool-app|dnb-suite|dns-flat|domain-oracle|eu-ai-act-test|fleet-oracle|fread|kid-story-book|kvk-tracker|langchain-omnirun|learning-platform|ledgersoft|lemon-chat|llama-index-tools-omnirun|lora-tune-mlx|mkb-ai-suite|mlxgpt|mlxstudio|munchwave-app|nepaligo|next-lm-chat|next-template|omnidoku|omnirun|omnirun-claude-managed-agents-worker|omnirun-cli|omnirun-cloud|omnirun-examples|omnirun-next|omnirun-sdk|omnirun-sdk-python|parametric-closet-designer|portfolio-landings|project-emergent|robo-challenge|scalarops-ai|scalarops-web|sigil-logomaker|tenantshield|time-tracker|unicornstudio|viberr|zynosure-design-system|zynosure-marketing|zynosure-suite)$/"
      ],
      "automerge": false
    },
    {
      "description": "Same default-off rule, stated for the lockFileMaintenance update type explicitly",
      "matchRepositories": [
        "!/^a14a-org\\/(102projects|a14a-landing|a14a-os|a14a-platform-poc|albion-market-tool|axinite|betaaldbereik|bun-api-template|cantrip|ccj-web|chili-app|chili-chat|chili-contracts|chili-design-system|chilicms|chilicomply|chilicrm|chilidesk|chilitrack|chipts|claude-temper|claudebox|claudecode-skill-manager-site|claudeskill-manager|client-brandkits|combin3-app|commandr|create-chili-app|creds-oracle|design-tool-app|dnb-suite|dns-flat|domain-oracle|eu-ai-act-test|fleet-oracle|fread|kid-story-book|kvk-tracker|langchain-omnirun|learning-platform|ledgersoft|lemon-chat|llama-index-tools-omnirun|lora-tune-mlx|mkb-ai-suite|mlxgpt|mlxstudio|munchwave-app|nepaligo|next-lm-chat|next-template|omnidoku|omnirun|omnirun-claude-managed-agents-worker|omnirun-cli|omnirun-cloud|omnirun-examples|omnirun-next|omnirun-sdk|omnirun-sdk-python|parametric-closet-designer|portfolio-landings|project-emergent|robo-challenge|scalarops-ai|scalarops-web|sigil-logomaker|tenantshield|time-tracker|unicornstudio|viberr|zynosure-design-system|zynosure-marketing|zynosure-suite)$/"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep biome.json $schema version in lockstep with @biomejs/biome so Biome never rejects its own config",
      "managerFilePatterns": [
        "/(^|/)biome\\.jsonc?$/"
      ],
      "matchStrings": [
        "https://biomejs\\.dev/schemas/(?<currentValue>[^/]+?)/schema\\.json"
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "automerge": false
  },
  "lockFileMaintenance": {
    "enabled": false,
    "schedule": [
      "after 10pm on saturday",
      "before 6am on sunday"
    ],
    "automerge": true,
    "commitMessageAction": "refresh",
    "commitMessageTopic": "lock file",
    "commitMessageExtra": ""
  },
  "rebaseWhen": "conflicted"
}
