{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Amsterdam",
  "labels": ["dependencies", "renovate"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 10,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Auto-merge patch + minor updates after CI passes",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "groupName": "minor and patch updates",
      "groupSlug": "minor-and-patch"
    },
    {
      "description": "Major updates open a PR but require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"]
    },
    {
      "description": "Group and auto-merge non-major GitHub Actions updates (majors fall through to the major rule above)",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Isolate next-auth beta — requires manual review",
      "matchPackageNames": ["next-auth", "@auth/core"],
      "groupName": "next-auth",
      "automerge": false
    },
    {
      "description": "Isolate toolchain deps — linter/formatter upgrades need human review",
      "matchPackageNames": ["@biomejs/biome", "typescript", "playwright", "lefthook"],
      "groupName": "toolchain",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep biome.json $schema version in lockstep with @biomejs/biome so Biome never rejects its own config",
      "managerFilePatterns": ["/(^|/)biome\\.jsonc?$/"],
      "matchStrings": ["https://biomejs\\.dev/schemas/(?<currentValue>[^/]+?)/schema\\.json"],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": true
  }
}
