{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "after 10pm on saturday",
    "before 6am on sunday"
  ],
  "automergeSchedule": [
    "after 10pm on saturday",
    "before 6am on sunday"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "commitMessageExtra": "from {{currentVersion}} to {{newVersion}}",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "3 days",
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "description": "Auto-merge patch + minor updates after CI passes",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "groupName": "minor and patch updates",
      "groupSlug": "minor-and-patch"
    },
    {
      "description": "Major updates wait for approval on the Dependency Dashboard, then open a PR that needs manual review",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "addLabels": [
        "major-update"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group and auto-merge non-major GitHub Actions updates (majors fall through to the major rule above)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "github-actions",
      "automerge": true
    },
    {
      "description": "Isolate next-auth beta \u2014 requires manual review",
      "matchPackageNames": [
        "next-auth",
        "@auth/core"
      ],
      "groupName": "next-auth",
      "automerge": false
    },
    {
      "description": "Isolate toolchain deps \u2014 linter/formatter upgrades need human review",
      "matchPackageNames": [
        "@biomejs/biome",
        "typescript",
        "playwright",
        "lefthook"
      ],
      "groupName": "toolchain",
      "automerge": false
    },
    {
      "description": "Postgres majors are data migrations (pg_upgrade + verified backups), not dependency bumps \u2014 RED tier, manual runbook only",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "library/postgres"
      ],
      "allowedVersions": "<18"
    },
    {
      "description": "GREEN-tier: auto-merge @types/* major bumps \u2014 type definitions only, build-time, zero runtime risk (CI gates)",
      "matchPackageNames": [
        "@types/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "GREEN-tier: auto-merge GitHub Actions major bumps \u2014 CI-only change, no app runtime impact (CI gates)",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "HOLD TypeScript 7 in repos linting with typescript-eslint / eslint-config-next: typescript-eslint (8.70.1) peers typescript <6.1.0 and cannot load TS7 (no JS API). Biome repos are unaffected. Lift once typescript-eslint supports TypeScript 7.",
      "matchRepositories": [
        "a14a-org/aircoland-chat",
        "a14a-org/chili-chat",
        "a14a-org/chilitrack",
        "a14a-org/chipts",
        "a14a-org/cjp-app-demo",
        "a14a-org/cjp-deck",
        "a14a-org/cjp-quiz-deck",
        "a14a-org/cjpnl-v2",
        "a14a-org/coinmerce-all-hands-presentation",
        "a14a-org/datagigant-suite",
        "a14a-org/design-tool-app",
        "a14a-org/domeinenlijst-suite",
        "a14a-org/forager-app",
        "a14a-org/grs-chat",
        "a14a-org/n8n-nodes-twinfield",
        "a14a-org/omnidoku",
        "a14a-org/omnirun"
      ],
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "<7"
    },
    {
      "description": "HOLD ESLint 10: eslint-plugin-react 7.37.x (also pulled in by eslint-config-next) peers eslint <=9.7 and crashes on 10 (getFilename removed). Lift once it supports ESLint 10.",
      "matchPackageNames": [
        "eslint"
      ],
      "allowedVersions": "<10"
    },
    {
      "description": "Vite and @vitejs/plugin-react majors must move together (plugin peers the matching Vite major); one PR instead of two that each fail alone.",
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "vite"
    },
    {
      "description": "Repos whose branch protection requires an up-to-date branch: auto-merge stalls unless Renovate rebases branches that fall behind, so these keep behind-base-branch. Everywhere else rebaseWhen=conflicted avoids re-running CI on every open Renovate branch after each merge.",
      "matchRepositories": [
        "a14a-org/chilitrack",
        "a14a-org/cjp-deck",
        "a14a-org/mlxstudio",
        "a14a-org/omnirun-sdk-python",
        "a14a-org/mkb-ai-suite",
        "a14a-org/lora-tune-mlx",
        "a14a-org/learning-platform",
        "a14a-org/langchain-omnirun",
        "a14a-org/llama-index-tools-omnirun",
        "a14a-org/chilidesk",
        "a14a-org/omnirun-claude-managed-agents-worker",
        "a14a-org/chilicms",
        "a14a-org/datagigant-suite",
        "a14a-org/chili-contracts"
      ],
      "rebaseWhen": "behind-base-branch"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep biome.json $schema version in lockstep with @biomejs/biome so Biome never rejects its own config",
      "managerFilePatterns": [
        "/(^|/)biome\\.jsonc?$/"
      ],
      "matchStrings": [
        "https://biomejs\\.dev/schemas/(?<currentValue>[^/]+?)/schema\\.json"
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security"
    ],
    "automerge": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "after 10pm on saturday",
      "before 6am on sunday"
    ],
    "automerge": true
  },
  "rebaseWhen": "conflicted"
}
